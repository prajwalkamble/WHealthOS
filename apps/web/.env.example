# WHealthOS — web application environment
#
# Copy to .env and fill in. .env is gitignored and must stay that way.
# database/.env is a symlink to this file, so credentials exist in one place.

# --- Application ---------------------------------------------------------
# Calendar used for every "this month" figure. Defaults to Asia/Kolkata.
APP_TIME_ZONE="Asia/Kolkata"

# The public address this deployment is served from, with scheme and no
# trailing slash. Required in production: it is what app/sitemap.js and
# app/robots.js publish, and what metadataBase resolves Open Graph images
# against, so a shared link previews bare without it.
#
# NOT prefixed NEXT_PUBLIC_, on purpose. Next inlines NEXT_PUBLIC_ variables
# at build time, so one set only at start-up would be ignored and the build
# would keep the localhost fallback -- serving "Disallow: /" and a sitemap
# full of localhost URLs, with nothing failing to tell you. This is read on
# the server at runtime instead.
#
# It also decides whether this deployment asks to be indexed at all. Only a
# production run WITH this set serves an allowing robots.txt; a preview or
# staging copy serves "Disallow: /" instead, so it cannot compete with the
# real site in search results. Leave it unset on staging.
SITE_URL="https://example.com"

# --- Billing switches ----------------------------------------------------
# Whether paid plans are offered. Unset (the default) means they are not:
# /pricing says the plans are discontinued, the Settings card shows no plan
# tiles, /billing redirects to /pricing and /api/billing/checkout refuses with
# PLANS_NOT_ON_SALE. Nothing is deleted -- set this to "on" to sell again, and
# rewrite /pricing and its FAQ in the same change (a test enforces that).
# BILLING_PLANS_ON_SALE="on"
#
# Whether entitlements are enforced. Unset means every account gets every
# feature whatever it has paid.
#
# THESE TWO GO TOGETHER, and since 2026-11-10 both are on. Section 6 of the
# Terms describes enforced plans, so leaving this unset is what would make the
# Terms false -- it is not a safe default any more, it is the contradiction.
# Set it in every environment that serves the published Terms.
#
# tests/legal-consistency.test.js holds a tripwire for the pair, but it can
# only fire when the variable is explicitly set: a test cannot know how a
# deployment is configured, and unset is indistinguishable from forgotten. The
# check that catches it in a real deployment is billingPolicyContradictions()
# in lib/security/required-config.js, which logs at boot in production.
BILLING_ENFORCEMENT="on"

# Applies the per-day transaction cap data/pricing.js advertises (Free 5,
# Pro 15, Intelligent uncapped). Separate from BILLING_ENFORCEMENT, and off
# for a reason: the Terms say nothing about a daily limit and section 6
# promises notice before a free feature is moved behind a plan, so switching
# this on means rewriting section 6, bumping TERMS in lib/legal/versions.js
# and giving that notice first. tests/legal-consistency.test.js fails the
# build if it is set to "on" while those are still outstanding.
# BILLING_QUOTA_ENFORCEMENT="on"

# --- Development feature override ----------------------------------------
# Unlocks every feature in data/pricing.js for ONE named account, for local
# development and testing. It grants feature eligibility only: it writes
# nothing, creates no subscription, charges nothing, modifies no payment
# record, and leaves the account's real plan reported as it is everywhere the
# application reports a plan.
#
# Leave all three unset unless you are that account. Placeholders only in this
# file -- the real values belong in .env, which is gitignored.
#
# Why it cannot operate on a deployment: devOverrideEnabled() in
# lib/billing/dev-override.js requires process.env.VERCEL to be ABSENT, and
# Vercel sets it in Production, Preview and the build alike. NODE_ENV is NOT
# used for this, deliberately -- a local `pnpm build && next start` runs as
# production, and keying off it would disable the override in exactly the
# configuration a change is verified in. Separately, Vercel does not read
# .env at all, so these would have to be pasted into the dashboard by hand
# for the question to arise; if they are, reportDevOverrideState() logs
# DEV_OVERRIDE_ENABLED_ON_VERCEL at boot.
#
# "on" to match the billing switches above. Anything else, including "true",
# is off.
# DEV_FEATURE_OVERRIDE="on"
#
# The authorisation value, and the only one: the immutable internal users.id
# (a uuid), which getCurrentUserId() derives server-side from the verified
# Clerk session. Never a value a request can carry. Look it up directly --
# an address pasted from a sign-in screen is not it:
#
#   select id, clerk_user_id from users where email = 'you@example.com';
#
# DEV_FEATURE_OVERRIDE_USER_ID="00000000-0000-0000-0000-000000000000"
#
# Which account that uuid is. REQUIRED -- absent or malformed and the override
# is disabled -- but never matched against a request and never what identifies
# the account. It is a completeness check: an id with no address beside it is
# an opaque uuid nobody reading this file can verify, and a half-written
# override should do nothing rather than something. The id is what authorises,
# because re-deriving it from an address would mean an email lookup at all 20
# server-side gates on every request. docs/development/DEV_FEATURE_OVERRIDE.md
# records how the binding was verified.
# DEV_FEATURE_OVERRIDE_EMAIL="you@example.com"

# --- Authentication (Clerk) ----------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_..."
CLERK_SECRET_KEY="sk_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# Signing secret for the Clerk webhook, from the endpoint's page in the Clerk
# dashboard. Subscribe that endpoint to user.deleted and point it at
# /api/webhooks/clerk. Without this the endpoint answers 500 and Clerk retries,
# which is deliberate: a deletion that is silently dropped leaves someone's
# financial records behind after they asked for them to be gone.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# --- Database (PostgreSQL) -----------------------------------------------
# These two are not interchangeable, and getting them the wrong way round
# fails silently. DATABASE_URL must NOT be the superuser (`postgres` on a
# managed instance has BYPASSRLS) and must not belong to whealth_jobs: either
# one skips every row-level security policy for ordinary requests, nothing
# errors, and no test catches it. lib/prisma.js asks the database directly on
# the first tenant query and logs loudly if it finds one of them.
#
# DATABASE_URL: the request path. Should be the restricted application role,
#   which is subject to row-level security.
# DIRECT_URL: migrations and background jobs. Owner role.
# Percent-encode any special characters in the password.
DATABASE_URL="postgresql://user:password@host:5432/whealth?schema=public"
DIRECT_URL="postgresql://owner:password@host:5432/whealth?schema=public"

# --- Email (Resend) ------------------------------------------------------
# Outbound and inbound both go through Resend. One client, in lib/email/.
RESEND_API_KEY="re_..."

# Sender, on a domain verified in Resend. Required in production: unset and
# every send is refused rather than attempted, because an unverified sender is
# rejected for every recipient.
RESEND_FROM_EMAIL="WHealthOS <hello@yourdomain.com>"

# Optional. Default Reply-To for automated mail, when replies should reach a
# different mailbox from the sender. Unset means no Reply-To header is added.
# Only set it to an address that someone actually reads.
RESEND_REPLY_TO_EMAIL=""

# Where the in-app feedback widget delivers, and where a verified inbound
# email is forwarded. The official business inbox, and the only destination
# feedback has -- never a personal or developer address, and never anything a
# user can influence.
#
# Unset, feedback is still SAVED and the notification is left owed: the row
# stays QUEUED, the delivery is marked FAILED with "recipient not configured",
# and the hourly sweep retries it once this is set. It used to be the other
# way round -- no address meant the widget refused and the message was lost.
FEEDBACK_EMAIL="you@yourdomain.com"

# Signing secret for the Resend webhook, from the webhook's page in the Resend
# dashboard. Required for inbound: without it /api/webhooks/resend refuses
# every request rather than trusting one. Never a value starting with "re_" --
# that is the API key, not the webhook secret.
#
# It is also what records whether a subscription confirmation was DELIVERED
# rather than merely ACCEPTED by Resend. Subscribe the webhook to
# email.delivered, email.bounced and email.complained; without them a bounced
# confirmation to a paying subscriber is invisible. See docs/billing.md.
RESEND_WEBHOOK_SECRET="whsec_..."

# --- Billing (Razorpay subscriptions) ------------------------------------
# Razorpay Dashboard > Account & Settings > API Keys.
#
# The mode is read from the key id's own prefix, not configured separately:
# rzp_test_ charges nothing and rzp_live_ charges real cards. There is no
# RAZORPAY_MODE variable to set wrongly, and test and live credentials are
# never mixed in one deployment because both halves come from the same pair.
RAZORPAY_KEY_ID="rzp_test_..."

# The other half of the pair, and the only thing standing between a stranger
# and the merchant account. It signs subscriptions and verifies the signature
# the browser hands back. Server-side only: there is no NEXT_PUBLIC_
# equivalent and there must never be one.
RAZORPAY_KEY_SECRET="..."

# The SAME value as RAZORPAY_KEY_ID, exposed to the browser because Razorpay's
# checkout script needs it in the page. The key id is not a secret; the secret
# above is. Setting this to a different account's key id opens checkout on one
# account while the subscription lives on another, and Razorpay reports that
# as a payment problem rather than a configuration one -- so the checkout
# endpoint refuses with 503 when the two disagree rather than letting it
# happen.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# Webhook signing secret, from Dashboard > Settings > Webhooks, set when the
# endpoint is created. A DIFFERENT value from RAZORPAY_KEY_SECRET and not
# interchangeable with it: signing the check with the API secret rejects every
# genuine delivery. Unset, /api/webhooks/razorpay answers 500 and Razorpay
# retries -- it never treats a missing secret as "skip verification".
#
# Point the webhook at https://<your-domain>/api/webhooks/razorpay and
# subscribe it to the subscription.* events listed in lib/billing/webhook.js.
RAZORPAY_WEBHOOK_SECRET="..."

# Razorpay Plan ids, created in Dashboard > Subscriptions > Plans.
#
# One per plan and interval. These cannot be derived or guessed: the amount
# and the interval live on Razorpay's Plan object, so a wrong id charges the
# wrong price. A missing one makes that plan unbuyable -- the checkout
# endpoint refuses it -- rather than silently billable at somebody else's
# rate. Create each Plan at the price data/pricing.js advertises.
#
#   Pro          monthly  INR 399     yearly  INR 3,830
#   Intelligent  monthly  INR 699     yearly  INR 6,710
#
# (The yearly figures are twelve months less the 20% in YEARLY_DISCOUNT.
# tests/billing-plans.test.js asserts the server charges what the page shows.)
RAZORPAY_PLAN_PRO_MONTHLY="plan_..."
RAZORPAY_PLAN_PRO_YEARLY="plan_..."
RAZORPAY_PLAN_INTELLIGENT_MONTHLY="plan_..."
RAZORPAY_PLAN_INTELLIGENT_YEARLY="plan_..."

# Optional. The merchant's public razorpay.me handle -- just the name, so
# "whealthos" for https://razorpay.me/@whealthos.
#
# Documentation and a manual fallback only. It is deliberately NOT wired into
# entitlements: a razorpay.me link is a standalone payment with no
# subscription behind it and no reliable way to attribute it to an account, so
# money arriving that way cannot and must not grant a plan.
RAZORPAY_PAYMENT_HANDLE="whealthos"

# --- Entitlement enforcement ---------------------------------------------
# Whether the backend actually REFUSES a feature the plan does not include.
#
# Off unless set to exactly "on", and that default is a decision rather than
# an oversight. Turning it on with no subscription rows in the database
# immediately removes Budgets, Goals, Analytics, export and every AI feature
# from every existing account, because none of them has ever paid for
# anything. That is a commercial decision to make on a chosen date, not
# something that should happen because a billing branch was deployed.
#
# While it is off every check still runs and every denial is logged as
# ENTITLEMENT_WOULD_DENY, so the gaps are visible before they are enforced.
# The same shape as Arcjet's detectBot DRY_RUN in middleware.js.
#
# SET ON 2026-11-10. That commercial caution was the right call while the
# Terms still said paying unlocked nothing; section 6 no longer says it, and
# the operator chose to resolve the contradiction by switching this on rather
# than by retracting the document. So the paragraphs above describe what "off"
# used to mean, not where this stands.
#
# What it cost, recorded because it is the part worth knowing before switching
# it back: every account that has never paid loses Budgets, Goals, Analytics,
# export, dashboard and appearance customisation and the AI features on the
# first request after the deployment. The document and the variable have to
# move together, in whichever direction they move.
#
# Set in the "Billing switches" block at the top of this file; this section is
# the explanation, not a second assignment.
# BILLING_ENFORCEMENT="on"

# --- Security (Arcjet) ---------------------------------------------------
ARCJET_KEY="ajkey_..."

# --- Background jobs (Inngest) -------------------------------------------
#
# Setting these is NOT enough to make the jobs run. Inngest does not poll: it
# holds a registration -- an app URL and the functions it serves -- and fires
# crons against that. A deploy changes the code, not the registration, so
# nothing runs until something syncs.
#
# Normally the Vercel-Inngest integration syncs on every deploy. Without it,
# the failure is silent in the worst way: the endpoint answers correctly, the
# dashboard shows an app, and no job ever runs. Production's crons died on
# 2026-10-15 when a middleware change briefly had Arcjet refuse
# /api/inngest; the middleware was fixed and deployed, and the crons stayed
# dead for three weeks because nothing re-registered the app.
#
# To sync by hand:
#   node scripts/development/inngest-sync.mjs https://your-deployment
INNGEST_SIGNING_KEY="signkey-prod-..."
INNGEST_EVENT_KEY=""

# --- AI ------------------------------------------------------------------
# TEMPORARY. The hosted model call is being replaced by a self-hosted model
# (see docs/architecture/ai.md and ADR-004). No new hosted-LLM providers.
#
# Server-side only. There is no NEXT_PUBLIC_ equivalent and there must never
# be one: a key in a client bundle is a key anyone can read and spend.
GEMINI_API_KEY="..."

# Optional. The model every AI feature calls. Unset uses the default in
# lib/ai/gemini.js, which is what lib/legal/ai.js records as an audit fact.
# Set this when Google retires the default rather than editing code.
# GEMINI_MODEL="gemini-4-argon"

# --- WHOS Agent (the in-app assistant) -----------------------------------
# All optional: unset uses the defaults in lib/ai/agent-config.js, which are
# chosen to be cheap. Every one of these is a ceiling, and the two that
# actually drive the bill are the history budget and the answer length.
#
# The model the assistant uses. Separate from GEMINI_MODEL above, and cheaper:
# the assistant is the only feature whose cost grows with how much it is used.
# Unset uses the default in lib/ai/gemini.js.
# WHOS_AGENT_MODEL="gemini-flash-lite-latest"
#
# WHOS_AGENT_MAX_MESSAGE_CHARS="1000"   one question's length
# WHOS_AGENT_MAX_HISTORY="8"            earlier messages resent for follow-ups
# WHOS_AGENT_MAX_HISTORY_CHARS="6000"   second ceiling on that history
# WHOS_AGENT_MAX_OUTPUT_TOKENS="900"    answer length
# WHOS_AGENT_TIMEOUT_MS="45000"         how long the provider gets
# WHOS_AGENT_REQUESTS_PER_HOUR="30"     per signed-in account, via Arcjet
# WHOS_AGENT_BURST="10"                 burst ceiling for the same bucket
#
# Google Search grounding, for questions whose answer changes over time (a
# current policy rate, a live price). OFF unless set to exactly "on", and off
# is the honest default: it bills as a search per request on the paid tier,
# it is unavailable on some unpaid projects, and it sends the question outside
# the model. While it is off the assistant refuses to state a live figure and
# says it cannot verify one, which is the correct behaviour either way.
# WHOS_AGENT_SEARCH_GROUNDING="on"
#
# Which tool shape to send, if grounding is on. The installed SDK
# (@google/generative-ai 0.21.0) types only the older "retrieval" shape, which
# Gemini 2.0 and later reject; "search" is the newer one and is the default
# here. Neither has been confirmed against this project's model. If a grounded
# request fails with a 400 about an unknown tool, try the other value.
# WHOS_AGENT_SEARCH_TOOL="search"   # or "retrieval"
#
# FUTURE — the local model's serving endpoint. Not yet used.
# WHEALTHOS_LLM_URL="http://localhost:8080"

# --- Development ---------------------------------------------------------
# Optional. The database suites create and delete rows, so they run only
# against a local database unless ALLOW_REMOTE_TEST_DB=1 is set deliberately.
# Put these in .env.test, never here.
# DATABASE_URL / DIRECT_URL pointing at a disposable local database.
